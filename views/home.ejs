
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Shortly</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', Arial, sans-serif;
        }

        body {
            background: #f5f6fb;
            color: #1e293b;
        }

        /* NAVBAR */

        .navbar {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8%;
            border-bottom: 1px solid #e9edf3;
        }

        .logo {
            font-size: 27px;
            font-weight: 800;
            color: #111827;
            letter-spacing: -1px;
        }

        .logo span {
            color: #6366f1;
        }

        .nav-right a {
            text-decoration: none;
            color: #4f46e5;
            background: #f1f2ff;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        /* MAIN */

        .main {
            max-width: 1150px;
            margin: 45px auto;
            padding: 0 25px;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h1 {
            font-size: 30px;
            color: #111827;
            margin-bottom: 9px;
        }

        .welcome p {
            color: #64748b;
            font-size: 14px;
        }

        /* GENERATED URL MESSAGE */

        .generated-box {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            padding: 17px 20px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .generated-box p {
            color: #065f46;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .generated-box a {
            color: #059669;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            word-break: break-all;
        }

        /* URL INPUT CARD */

        .url-card {
            background: linear-gradient(120deg, #3730a3, #6366f1);
            padding: 35px;
            border-radius: 16px;
            color: white;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(79,70,229,0.15);
        }

        .url-card h2 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .url-card p {
            font-size: 14px;
            color: #e0e7ff;
            margin-bottom: 22px;
        }

        .url-form {
            display: flex;
            gap: 12px;
        }

        .url-form input {
            flex: 1;
            height: 52px;
            padding: 0 17px;
            border: none;
            outline: none;
            border-radius: 8px;
            font-size: 14px;
        }

        .url-form button {
            padding: 0 28px;
            background: #111827;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .url-form button:hover {
            background: #252f43;
            transform: translateY(-2px);
        }

        /* STATISTICS */

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 24px;
            border-radius: 13px;
            border: 1px solid #edf0f5;
        }

        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .stat-top p {
            font-size: 13px;
            color: #64748b;
            font-weight: 600;
        }

        .stat-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 18px;
        }

        .stat-card h2 {
            font-size: 27px;
            color: #111827;
        }

        /* TABLE */

        .table-card {
            background: white;
            border-radius: 14px;
            border: 1px solid #edf0f5;
            overflow: hidden;
        }

        .table-heading {
            padding: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #edf0f5;
        }

        .table-heading h2 {
            font-size: 19px;
            color: #111827;
        }

        .table-heading span {
            font-size: 13px;
            color: #64748b;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            padding: 17px 22px;
            background: #f8fafc;
            font-size: 12px;
            color: #64748b;
            font-weight: 700;
            text-transform: uppercase;
        }

        td {
            padding: 19px 22px;
            font-size: 13px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: #fafbff;
        }

        .short-link {
            color: #4f46e5;
            font-weight: 600;
            text-decoration: none;
        }

        .original-link {
            max-width: 250px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: block;
            color: #64748b;
            text-decoration: none;
        }

        .click-badge {
            background: #eef2ff;
            color: #4f46e5;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .copy-btn {
            background: #f1f5f9;
            color: #334155;
            border: none;
            padding: 8px 13px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
        }

        .copy-btn:hover {
            background: #e0e7ff;
            color: #4f46e5;
        }

        /* EMPTY STATE */

        .empty-state {
            text-align: center;
            padding: 45px 20px;
            color: #94a3b8;
        }

        .empty-state h3 {
            color: #334155;
            margin-bottom: 8px;
            font-size: 17px;
        }

        .empty-state p {
            font-size: 13px;
        }

        /* FOOTER */

        .footer {
            text-align: center;
            padding: 30px;
            color: #94a3b8;
            font-size: 12px;
        }

        /* RESPONSIVE */

        @media(max-width: 768px) {

            .navbar {
                padding: 0 20px;
            }

            .main {
                margin-top: 30px;
            }

            .welcome h1 {
                font-size: 24px;
            }

            .url-card {
                padding: 25px 20px;
            }

            .url-form {
                flex-direction: column;
            }

            .url-form button {
                height: 48px;
            }

            .stats {
                grid-template-columns: 1fr;
                gap: 12px;
            }

        }

    </style>

</head>

<body>

    <%
        const urlList = locals.urls || [];
        const totalClicks = urlList.reduce(
            (total, url) => total + url.visithistory.length, 0
        );
    %>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            shortly<span>.</span>
        </div>

        <div class="nav-right">
            <a href="/login">Logout</a>
        </div>

    </nav>


    <main class="main">

        <!-- WELCOME -->

        <section class="welcome">

            <h1>Welcome back 👋</h1>

            <p>
                Shorten your links and track their performance in one place.
            </p>

        </section>


        <!-- GENERATED URL -->

        <% if (locals.id) { %>

            <div class="generated-box">

                <p>✓ Your short URL has been generated successfully!</p>

                <a href="http://localhost:8001/<%= id %>" target="_blank">
                    http://localhost:8001/<%= id %>
                </a>

            </div>

        <% } %>


        <!-- URL SHORTENER -->

        <section class="url-card">

            <h2>Shorten a new URL</h2>

            <p>
                Paste your long URL below and generate a short link instantly.
            </p>

            <form action="/url" method="POST" class="url-form">

                <input
                    type="url"
                    name="url"
                    placeholder="https://www.example.com/your-long-url"
                    required
                >

                <button type="submit">
                    Generate Link →
                </button>

            </form>

        </section>


        <!-- STATISTICS -->

        <section class="stats">

            <div class="stat-card">

                <div class="stat-top">

                    <p>Total Links</p>

                    <div class="stat-icon">🔗</div>

                </div>

                <h2><%= urlList.length %></h2>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <p>Total Clicks</p>

                    <div class="stat-icon">👆</div>

                </div>

                <h2><%= totalClicks %></h2>

            </div>

        </section>


        <!-- URL HISTORY -->

        <section class="table-card">

            <div class="table-heading">

                <h2>Your Links</h2>

                <span><%= urlList.length %> links created</span>

            </div>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>
                            <th>S.No</th>
                            <th>Short URL</th>
                            <th>Original URL</th>
                            <th>Clicks</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        <% if (urlList.length > 0) { %>

                            <% urlList.forEach((url, index) => { %>

                                <tr>

                                    <td><%= index + 1 %></td>

                                    <td>

                                        <a
                                            href="/<%= url.shortId %>"
                                            target="_blank"
                                            class="short-link"
                                        >
                                            <%= url.shortId %>
                                        </a>

                                    </td>


                                    <td>

                                        <a
                                            href="<%= url.redirecturl %>"
                                            target="_blank"
                                            class="original-link"
                                        >
                                            <%= url.redirecturl %>
                                        </a>

                                    </td>


                                    <td>

                                        <span class="click-badge">
                                            <%= url.visithistory.length %>
                                        </span>

                                    </td>


                                    <td>

                                        <button
                                            class="copy-btn"
                                            onclick="copyLink('<%= url.shortId %>')"
                                        >
                                            Copy
                                        </button>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td colspan="5">

                                    <div class="empty-state">

                                        <h3>No links created yet</h3>

                                        <p>
                                            Paste your first URL above to get started.
                                        </p>

                                    </div>

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </section>

    </main>


    <!-- FOOTER -->

    <footer class="footer">
        © 2026 Shortly. All rights reserved.
    </footer>


    <!-- COPY FUNCTION -->

    <script>

        function copyLink(shortId) {

            const shortUrl = window.location.origin + "/" + shortId;

            navigator.clipboard.writeText(shortUrl)
                .then(() => {
                    alert("Short link copied successfully!");
                })
                .catch(() => {
                    alert("Unable to copy link.");
                });

        }

    </script>

</body>

</html>